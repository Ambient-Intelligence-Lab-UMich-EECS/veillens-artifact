*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# --- editors / OS ---
.DS_Store
.idea/
.vscode/

# --- archives ---
*.tar.gz
*.tgz
*.zip

