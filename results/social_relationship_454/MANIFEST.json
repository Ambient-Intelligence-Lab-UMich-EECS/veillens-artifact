      "raw": {
        "what": "attack.py on annotated/<image_id>.jpg \u2014 every subject boxed and numbered. The oracle evaluator is the exception: it reads the unannotated image and runs its own detector.",
        "runs": [
          {
            "model": "oracle",
            "responses": 454,
            "bytes": 397389,
            "gt_pairs": 1518,
            "answered_pairs": 1109,
            "six_way_all_pairs": 0.5323,
            "three_way_all_pairs": 0.5718,
            "protocol": "own detector, not ground-truth boxes \u2014 see evaluation/raw/oracle/summary.json"
          },
          {
            "model": "gemini-2.5-flash",
            "responses": 454,
            "bytes": 425375,
            "gt_pairs": 1518,
            "six_way": 0.6785,
            "three_way": 0.7411
          },
          {
            "model": "gemini-3.1-flash-lite",
            "responses": 454,
            "bytes": 391489,
            "gt_pairs": 1518,
            "six_way": 0.6785,
            "three_way": 0.7484
          },
          {
            "model": "gemini-3.1-pro-preview",
            "responses": 454,
            "bytes": 344707,
            "gt_pairs": 1518,
            "six_way": 0.7095,
            "three_way": 0.7701
          }
        ]
      },
      "defended": {
        "what": "attack.py on def_img/<image_id>.jpg \u2014 only the subjects NOT predicted to be in a relationship are boxed",
        "runs": [
          {
            "model": "gemini-2.5-flash",
            "responses": 41,
            "bytes": 33769,
            "correct_six_way": 57,
            "correct_three_way": 59
          },
          {
            "model": "gemini-3.1-flash-lite",
            "responses": 41,
            "bytes": 29358,
            "correct_six_way": 50,
            "correct_three_way": 53
