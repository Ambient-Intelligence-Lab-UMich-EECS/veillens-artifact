  "parts": {
    "process": {
      "path": "process/<image_id>/round1_full_img.json",
      "images": 454,
      "files": 454,
      "bytes": 397389,
      "what": "gpt-5 reading the unprotected image and predicting a label for every detected pair. This is both the raw gpt-5 baseline and the input defense.py consumes to decide which subjects to withhold.",
      "model": "gpt-5",
      "model_id_recorded_in_artifacts": null,
      "attribution": "the source run directory is named gpt-5_20260422_154635 and predict_from_detection.py sets MODEL='gpt-5'; no response file carries a model field",
      "read_image": "the original PISC image; this stage runs its OWN person detector rather than using ground-truth boxes",
      "coverage_caveat": "detection misses subjects, so only 1109 of the 1518 ground-truth pairs received an answer (73.1%). Accuracy over all 1518 pairs is 0.5323; over the 1109 answered pairs it is 0.7286. The two attack.py runs use ground-truth boxes and answer ~100% of pairs, so gpt-5's number is NOT directly comparable to theirs.",
      "empty_raw_response": 52
    },
    "evaluation": {
      "path": "evaluation/<condition>/<model>/responses/<image_id>.json",
      "layout_note": "This experiment has two attack conditions, so evaluation/ carries an extra level (raw|defended) that results/compositional_500 and results/geolocation_100 do not have.",
      "raw": {
        "what": "attack.py on annotated/<image_id>.jpg \u2014 every subject boxed and numbered",
        "runs": [
          {
            "model": "gemini-3.1-flash-lite",
            "responses": 200,
            "bytes": 169345,
            "gt_pairs": 646,
            "six_way": 0.6827,
            "three_way": 0.726
          },
          {
            "model": "gemini-3.1-pro-preview",
            "responses": 161,
            "bytes": 119688,
            "gt_pairs": 528,
            "six_way": 0.7311,
            "three_way": 0.7784
          }
        ]
      },
      "defended": {
        "what": "attack.py on def_img/<image_id>.jpg \u2014 only the subjects NOT predicted to be in a relationship are boxed",
        "runs": [
          {
            "model": "gemini-3.1-flash-lite",
            "responses": 41,
            "bytes": 29358,
            "correct_six_way": 50,
            "correct_three_way": 53
          },
          {
            "model": "gpt-5.2",
            "responses": 41,
            "bytes": 33012,
            "correct_six_way": 65,
            "correct_three_way": 69
          }
        ]
      },
      "coverage_matrix": {
        "gemini-3.1-flash-lite": [
          "raw",
          "defended"
        ],
        "gemini-3.1-pro-preview": [
          "raw"
        ],
        "gpt-5": [
          "process only (detection pipeline)"
        ],
        "gpt-5.2": [
          "defended"
        ],
        "note": "four distinct models appear, but no single condition was run with all four and only gemini-3.1-flash-lite has both conditions."
      }
    }
  },
