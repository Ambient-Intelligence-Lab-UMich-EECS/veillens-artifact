            "model": "gemini-3.1-pro-preview",
            "responses": 41,
            "bytes": 25345,
            "correct_six_way": 61,
            "correct_three_way": 64
          },
          {
            "model": "gpt-5.2",
            "responses": 41,
            "bytes": 33012,
            "correct_six_way": 65,
            "correct_three_way": 69
          }
        ]
      },
      "coverage_matrix": {
        "oracle": [
          "raw"
        ],
        "gemini-2.5-flash": [
          "raw",
          "defended"
        ],
        "gemini-3.1-flash-lite": [
          "raw",
          "defended"
        ],
        "gemini-3.1-pro-preview": [
          "raw",
          "defended"
        ],
        "gpt-5.2": [
          "defended"
        ],
        "note": "all 454 raw images carry 4 evaluators (oracle, gemini-2.5-flash, gemini-3.1-flash-lite, gemini-3.1-pro-preview) and all 41 defended images carry 4 (the three gemini models plus gpt-5.2). The oracle is gpt-5 running the detection pipeline: it reads the unprotected image with its own person detector rather than ground-truth boxes, so it answers only 1109 of 1518 pairs and is NOT protocol-comparable to the other three raw evaluators. Its responses are byte-identical copies of process/<image_id>/round1_full_img.json. gpt-5.2 is defended-only."
      }
    }
