# Copy to .env (which is gitignored) and fill in whichever values you need.
# Nothing here is required to install, run --dry-run, or score an existing run.

# --- The VLM provider. Needed only to run the protection loop. ---
OPENAI_API_KEY=

# --- Where the heavy things live. Defaults are inside the repo. ---
# Datasets and model weights.
# VEILLENS_DATA=/path/to/veillens-data
# Pipeline output.
# VEILLENS_RUNS=/path/to/veillens-runs
# Checkpoints (defaults to $VEILLENS_DATA/models).
# VEILLENS_MODELS=/path/to/veillens-data/models
# HuggingFace cache, for the diffusion and CLIP weights fetched on first use.
# HF_HOME=/path/to/veillens-data/hf_cache
# Grounded-SAM-2, if you already have it checked out somewhere other than
# third_party/Grounded-SAM-2. Reachable in configs as ${paths.gsam2}.
# VEILLENS_GSAM2=/path/to/Grounded-SAM-2
# GeoShield, same idea. Only the `geoshield` baseline uses it. As ${paths.geoshield}.
# VEILLENS_GEOSHIELD=/path/to/GeoShield
